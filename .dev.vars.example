# Copy to .dev.vars (the test group, for `wrangler dev`) or .prod.vars (the friends' chat, for the
# setup script). Both hold the same bot's token. Never commit real values.
BOT_TOKEN=123456789:token-from-botfather
# 32+ characters of A-Za-z0-9_-; the same value goes to the setup script.
WEBHOOK_SECRET=replace-with-32-plus-random-characters
# The group's supergroup id (-100…), as the setup script's `discover` prints it.
ALLOWED_CHAT_ID=-1001234567890
# The JSON of getMe for the bot, on one line.
BOT_INFO={"id":123456789,"is_bot":true,"first_name":"Squad Bot","username":"squad_bot","can_join_groups":true,"can_read_all_group_messages":false,"supports_inline_queries":false,"can_connect_to_business":false,"has_main_web_app":false}
