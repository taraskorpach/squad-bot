# Copy to .dev.vars for `wrangler dev` with the dev bot. Never commit real values.
BOT_TOKEN=123456789:dev-bot-token-from-botfather
# 32+ characters of A-Za-z0-9_-; the same value goes to the setup script.
WEBHOOK_SECRET=replace-with-32-plus-random-characters
# The test group's supergroup id (-100…), as the setup script's `discover` prints it.
ALLOWED_CHAT_ID=-1001234567890
# The JSON of getMe for the dev bot, on one line.
BOT_INFO={"id":123456789,"is_bot":true,"first_name":"Squad Dev","username":"squad_dev_bot","can_join_groups":true,"can_read_all_group_messages":false,"supports_inline_queries":false,"can_connect_to_business":false,"has_main_web_app":false}
